exports.permisosporrol = async (req, res) => {
  const conn = await pool.getConnection();
  try {
    const [rows] = await conn.execute(`
      SELECT rp.rol_id, ap.name as permiso_name
      FROM auxrolspermissions rp
      JOIN auxpermissions ap ON rp.permission_id = ap.idp
      ORDER BY rp.rol_id, ap.name
    `);

    const permisosPorRol = {};
    rows.forEach((row) => {
      if (!permisosPorRol[row.rol_id]) permisosPorRol[row.rol_id] = [];
      permisosPorRol[row.rol_id].push(row.permiso_name);
    });

    const [roles] = await conn.execute("SELECT idr FROM auxrols ORDER BY idr");
    roles.forEach((rol) => {
      if (!permisosPorRol[rol.idr]) permisosPorRol[rol.idr] = [];
    });

    res.json(permisosPorRol);
  } catch (err) {
    console.error("❌ Error en /api/permisos-por-rol:", err);
    res.status(500).json({ message: "Error interno en el servidor" });
  } finally {
    conn.release();
  }
};

exports.saveRolPermissions = async (req, res) => {
  const { username, permisosPorRol } = req.body;
  const conn = await pool.getConnection();

  try {
    await conn.beginTransaction();

    // 🔹 Limpiar permisos existentes
    await conn.execute("DELETE FROM auxrolspermissions");

    for (const rolId of Object.keys(permisosPorRol)) {
      const permisos = permisosPorRol[rolId];
      for (const permisoName of permisos) {
        // 🔹 Obtener el ID del permiso
        const [permRows] = await conn.execute(
          "SELECT idp FROM auxpermissions WHERE name = ? LIMIT 1",
          [permisoName]
        );
        if (!permRows.length) continue;

        const permissionId = permRows[0].idp;

        // 🔹 Insertar el permiso
        await conn.execute(
          "INSERT INTO auxrolspermissions (rol_id, permission_id) VALUES (?, ?)",
          [rolId, permissionId]
        );

        // 🧾 Auditoría usando auditAction
        await auditAction({
          req,
          actor: { username },
          action: AUDIT_ACTIONS.PERMISSION_CHANGE,
          entity: AUDIT_ENTITIES.ROLE,
          entityId: rolId,
          description: `Se asignó permiso "${permisoName}" al rol ${rolId}`,
          metadata: { permissionId, permisoName }
        });
      }
    }

    await conn.commit();
    res.json({ success: true, message: "Permisos guardados correctamente" });
  } catch (err) {
    await conn.rollback();
    console.error("❌ Error guardando permisos por rol:", err);

    // Auditoría de fallo
    await auditAction({
      req,
      actor: { username },
      action: AUDIT_ACTIONS.PERMISSION_CHANGE,
      entity: AUDIT_ENTITIES.ROLE,
      description: "Error al guardar permisos por rol",
      metadata: { error: err.message }
    });

    res.json({ success: false, message: err.message });
  } finally {
    conn.release();
  }
};

