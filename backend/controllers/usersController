exports.usersave = async (req, res) => {
  const { rows, username } = req.body;
  const conn = await pool.getConnection();

  try {
    await conn.beginTransaction();

    for (const row of rows) {
      const {
        userid, // PK original ('' = nuevo usuario)
        usuario, // Nuevo userid para INSERT
        userpass,
        useremail,
        userspec,
        fullname,
        active,
        registeredpend,
        municipality,
        province,
        rols,
        permisos // ⭐ Array de nombres de permisos extras ["sujeto_solicitar"]
      } = row;

      // Determinar userid final
      const finalUserid =
        userid === "" ? usuario : usuario !== userid ? usuario : userid;

      if (userid === "") {
        // 🔹 INSERT NUEVO USUARIO
        if (!finalUserid) {
          throw new Error('Falta "usuario" para nuevo usuario');
        }

        // 1. Insertar usuario base
        await conn.execute(
          `INSERT INTO users 
           (userid, userpass, useremail, userspec, fullname, 
            active, registeredpend, municipality, province)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
          [
            finalUserid,
            userpass || null,
            useremail || null,
            userspec || null,
            fullname || null,
            active,
            registeredpend,
            municipality || null,
            province || null
          ]
        );

        // 2. Insertar roles
        if (rols && Array.isArray(rols)) {
          for (const rolName of rols) {
            const [rolRows] = await conn.execute(
              "SELECT idr FROM auxrols WHERE name = ?",
              [rolName]
            );
            if (rolRows.length > 0) {
              await conn.execute(
                "INSERT INTO auxusersrol (userid, rol_id) VALUES (?, ?)",
                [finalUserid, rolRows[0].idr]
              );
            }
          }
        }

        // 3. ⭐ Insertar permisos extras (si existen)
        if (permisos && Array.isArray(permisos) && permisos.length > 0) {
          await handleUserPermissions(conn, finalUserid, permisos);
        }

        // Auditoría
        await auditAction({
          req,
          actor: { username },
          action: AUDIT_ACTIONS.CREATE,
          entity: AUDIT_ENTITIES.USER,
          entityId: finalUserid,
          description: `Nuevo usuario creado: ${finalUserid}`
        });
      } else {
        // 🔹 UPDATE USUARIO EXISTENTE

        // 1. Actualizar tabla users
        await conn.execute(
          `UPDATE users SET
            userid = ?, userpass = ?, useremail = ?, userspec = ?, 
            fullname = ?, active = ?, registeredpend = ?, 
            municipality = ?, province = ?
           WHERE userid = ?`,
          [
            finalUserid,
            userpass || null,
            useremail || null,
            userspec || null,
            fullname || null,
            active,
            registeredpend,
            municipality || null,
            province || null,
            userid // userid original para WHERE
          ]
        );

        // 2. Actualizar roles (borrar + insertar)
        await conn.execute("DELETE FROM auxusersrol WHERE userid = ?", [
          finalUserid
        ]);
        if (rols && Array.isArray(rols)) {
          for (const rolName of rols) {
            const [rolRows] = await conn.execute(
              "SELECT idr FROM auxrols WHERE name = ?",
              [rolName]
            );
            if (rolRows.length > 0) {
              await conn.execute(
                "INSERT INTO auxusersrol (userid, rol_id) VALUES (?, ?)",
                [finalUserid, rolRows[0].idr]
              );
            }
          }
        }

        // 3. ⭐ MANEJAR PERMISOS EXTRAS
        if (permisos && Array.isArray(permisos) && permisos.length > 0) {
          // Hay permisos → borrar existentes + insertar nuevos
          await handleUserPermissions(conn, finalUserid, permisos);
        } else {
          // permisos vacío/null/undefined → BORRAR TODOS
          await conn.execute(
            "DELETE FROM auxmoreuserpermissions WHERE userid = ?",
            [finalUserid]
          );
        }

        // Auditoría
        await auditAction({
          req,
          actor: { username },
          action: AUDIT_ACTIONS.UPDATE,
          entity: AUDIT_ENTITIES.USER,
          entityId: finalUserid,
          description: `Usuario actualizado: ${userid} → ${finalUserid}`
        });
      }
    }

    await conn.commit();
    res.json({ success: true });
  } catch (err) {
    await conn.rollback();
    console.error("❌ Error guardando usuarios:", err);
    res.status(500).json({ error: err.message });
  } finally {
    conn.release();
  }
};

