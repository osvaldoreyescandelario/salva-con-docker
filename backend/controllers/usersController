      SELECT 
        u.userid, u.userpass, u.useremail, u.userspec, u.fullname, 
        u.active, u.registeredpend, u.municipality, u.province,
        ur.rol_id, r.name AS rol_name
      FROM users u
      JOIN auxusersrol ur ON ur.userid = u.userid
      JOIN auxrols r ON r.idr = ur.rol_id
    `;

    let paramsUsers = [];
    let conditions = [];

    if (requesterRole === "superv") {
      conditions.push("u.province = ?");
      conditions.push("ur.rol_id NOT IN (5,6)");
      paramsUsers.push(requesterProvince);
    }

    if (requesterRole === "admin") {
      conditions.push("ur.rol_id != 6");
    }

    if (conditions.length > 0) {
      sqlUsers += " WHERE " + conditions.join(" AND ");
    }

    const [users] = await conn.execute(sqlUsers, paramsUsers);

    if (users.length === 0) {
      return res.json({ rows: [] });
    }

    const userIds = users.map((u) => u.userid);

    // ===============================
    // 2. PERMISOS POR ROL
    // ===============================
    const [permissionsByRole] = await conn.execute(`
      SELECT rp.rol_id, p.name AS permission_name
      FROM auxrolspermissions rp
      JOIN auxpermissions p ON p.idp = rp.permission_id
    `);

    // ===============================
    // 3. PERMISOS EXTRA POR USUARIO
    // ===============================
    const [permissionsExtra] = await conn.execute(
      `
      SELECT ump.userid, p.name AS permission_name
      FROM auxmoreuserpermissions ump
      JOIN auxpermissions p ON p.idp = ump.permission_id
      WHERE ump.userid IN (${userIds.map(() => "?").join(",")})
    `,
      userIds
    );

    // ===============================
    // 4. MAPAS
    // ===============================
    const permsByRol = {};
    for (const p of permissionsByRole) {
      if (!permsByRol[p.rol_id]) permsByRol[p.rol_id] = [];
      permsByRol[p.rol_id].push(p.permission_name);
    }

    const extraPermsByUser = {};
    for (const p of permissionsExtra) {
      if (!extraPermsByUser[p.userid]) extraPermsByUser[p.userid] = [];
      extraPermsByUser[p.userid].push(p.permission_name);
    }

    // ===============================
    // 5. RESULTADO FINAL
    // ===============================
    const mappedRows = users.map((u) => {
      const userPermissionsSet = new Set();

      // permisos por rol
      const permsRol = permsByRol[u.rol_id] || [];
      permsRol.forEach((p) => userPermissionsSet.add(p));

      // permisos extra
      const extraPerms = extraPermsByUser[u.userid] || [];
      extraPerms.forEach((p) => userPermissionsSet.add(p));

      return {
        usuario: u.userid,
        userid: u.userid,
        password: u.userpass || "",
        correo: u.useremail || "",
        especialidad: u.userspec || "",
        nombre: u.fullname || "",
        rols: [u.rol_name], // ahora siempre 1
        permissions: Array.from(userPermissionsSet),
        activo: u.active === 1 ? "Sí" : "No",
        aprobado: u.registeredpend === 1 ? "Sí" : "No",
        cdo: u.municipality || "",
        provincia: u.province || ""
      };
    });

    // ===============================
    // 6. AUDITORÍA
    // ===============================
    await auditAction({
      req,
      actor: { username: auditUsername },
      action: AUDIT_ACTIONS.SELECT,
      entity: AUDIT_ENTITIES.USERS,
      entityId: null,
      description: "Carga de usuarios con filtro por rol/provincia",
      oldState: null,
      newState: { total: mappedRows.length }
    });

    res.json({ rows: mappedRows });
  } catch (err) {
    console.error("❌ Error en /api/users/load:", err);
    res.status(500).json({ error: err.message });
  } finally {
    conn.release();
  }
};

exports.permisosrol = async (req, res) => {
  const { roles, username } = req.body;

  if (!roles || !Array.isArray(roles) || roles.length === 0) {
    return res.status(400).json({ message: "Faltan roles" });
  }

  const conn = await pool.getConnection();

  try {
    // Construir placeholders para MySQL: ?, ?, ?, ...
    const placeholders = roles.map(() => "?").join(",");
    const sql = `
      SELECT DISTINCT p.idp, p.name, p.resource, p.tooltip
      FROM auxpermissions p
      JOIN auxrolspermissions rp ON p.idp = rp.permission_id
      JOIN auxrols r ON rp.rol_id = r.idr
      WHERE r.name IN (${placeholders})
    `;

    const [permisosResults] = await conn.execute(sql, roles);

    // 🧾 Auditoría usando auditAction
    await auditAction({
      req,
      actor: { username },
      action: AUDIT_ACTIONS.READ_SENSITIVE,
      entity: AUDIT_ENTITIES.PERMISSION,
      description: `Consulta permisos de roles: ${roles.join(", ")}`.substring(
        0,
        255
      ),
      metadata: {
        roles,
        permisos_count: permisosResults.length,
        permisos: permisosResults.map((p) => p.name)
      }
    });

    res.json({
      roles,
      permisos: permisosResults.map((p) => p.name)
    });
  } catch (err) {
    console.error("❌ Error obteniendo permisos por rol:", err);

    // Auditoría de error
    await auditAction({
      req,
      actor: { username },
      action: AUDIT_ACTIONS.READ_SENSITIVE,
      entity: AUDIT_ENTITIES.PERMISSION,
      description: "Error al consultar permisos por rol",
      metadata: { error: err.message, roles }
    });

    res.status(500).json({ message: "Error interno en el servidor" });
  } finally {
    conn.release();
  }
};

exports.getpermisosporrol = async (req, res) => {
