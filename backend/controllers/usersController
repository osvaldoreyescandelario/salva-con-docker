exports.login = async (req, res) => {
  const { user, pass } = req.body;

  if (!user || !pass) {
    return res
      .status(400)
      .json({ message: "Usuario y contraseña son requeridos." });
  }

  const queryUser = "SELECT * FROM users WHERE userid = ? LIMIT 1";

  try {
    // 🔓 CONSULTA DIRECTA - SIN runQuery (evita auditoría que bloquea)
    const [results] = await pool.execute(queryUser, [user]);

    if (results.length === 0) {
      await auditAction({
        req,
        actor: null,
        action: AUDIT_ACTIONS.LOGIN_FAILED,
        entity: AUDIT_ENTITIES.USER,
        entityId: user,
        description: `Intento de login fallido: usuario no existe`
      });
      return res.status(404).json({
        message: "🛑 El usuario no existe. Debe registrarse primero."
      });
    }

    const userData = results[0];

    // Contraseña incorrecta
    if (userData.userpass !== pass) {
      await auditAction({
        req,
        actor: null,
        action: AUDIT_ACTIONS.LOGIN_FAILED,
        entity: AUDIT_ENTITIES.USER,
        entityId: user,
        description: `Intento de login fallido: contraseña incorrecta`
      });
      return res.status(401).json({ message: "🛑 Contraseña incorrecta." });
    }

    // Usuario pendiente o bloqueado
    if (userData.registeredpend === 1 || userData.active === 0) {
      return res.status(403).json({
        message:
          userData.registeredpend === 1
            ? "⚠️ Registro pendiente de ser aprobado."
            : "⚠️ Usuario bloqueado."
      });
    }

    // Roles del usuario - SIN runQuery
    const rolesQuery = `
      SELECT r.idr, r.name, r.description
      FROM auxrols r
      JOIN auxusersrol ur ON r.idr = ur.rol_id
      WHERE ur.userid = ?
    `;
    const [rolesResults] = await pool.execute(rolesQuery, [user]);

    // ⭐ PERMISOS POR ROL - SIN runQuery
    const permisosByRoleQuery = `
      SELECT DISTINCT p.idp, p.name, p.resource, p.tooltip
      FROM auxpermissions p
      JOIN auxrolspermissions rp ON p.idp = rp.permission_id
      JOIN auxrols r ON rp.rol_id = r.idr
      JOIN auxusersrol ur ON r.idr = ur.rol_id
      WHERE ur.userid = ?
    `;
    const [permisosByRoleResults] = await pool.execute(permisosByRoleQuery, [
      user
    ]);

    // ⭐ PERMISOS EXTRAS - SIN runQuery
    const permisosExtraQuery = `
      SELECT DISTINCT p.idp, p.name, p.resource, p.tooltip
      FROM auxpermissions p
      JOIN auxmoreuserpermissions ump ON p.idp = ump.permission_id
      WHERE ump.userid = ?
    `;
    const [permisosExtraResults] = await pool.execute(permisosExtraQuery, [
      user
    ]);

    // Auditoría login exitoso
    await auditAction({
      req,
      actor: { username: user },
      action: AUDIT_ACTIONS.LOGIN,
      entity: AUDIT_ENTITIES.USER,
      entityId: user,
      description: "Inicio de sesión exitoso",
      metadata: {
        roles_count: rolesResults.length,
        permisos_count:
          permisosByRoleResults.length + permisosExtraResults.length
      }
    });

    // ⭐ COMBINAR permisos: rol + extras (sin duplicados)
    const todosPermisos = [...permisosByRoleResults, ...permisosExtraResults];
    const permisosUnicos = todosPermisos.reduce((acc, permiso) => {
      if (!acc.some((p) => p.name === permiso.name)) {
        acc.push(permiso);
      }
      return acc;
    }, []);

    // Respuesta exitosa
    res.json({
      message: "",
      userid: userData.userid,
      fullname: userData.fullname,
      useremail: userData.useremail,
      userspec: userData.userspec,
      municipality: userData.municipality,
      province: userData.province,
      active: userData.active,
      registeredpend: userData.registeredpend,
      rols: rolesResults.map((r) => r.name),
      permissions: permisosUnicos.map((p) => p.name) // ✅ Incluye rol + extras
    });
  } catch (err) {
    console.error("💥 ERROR COMPLETO en login:", err);
    return res.status(500).json({ message: "Error en la base de datos" });
  }
};

exports.newuser = async (req, res) => {
  const user = req.body;
  const conn = await pool.getConnection();

  try {
    await conn.beginTransaction();

    // Limpiar y validar campos
    const cleanUser = {
      userid: user.userid?.trim(),
      userpass: user.userpass,
      useremail: user.useremail?.trim().toLowerCase(),
      userspec: user.userspec?.trim(),
      active: parseInt(user.active) || 0,
      registeredpend: parseInt(user.registeredpend) || 1,
      fullname: user.fullname?.trim(),
      municipality: user.municipality?.trim(),
      province: user.province?.trim(),
      roles: user.roles || [],
      permissions: user.permissions || []
    };

    const required = [
      "userid",
      "userpass",
      "useremail",
      "userspec",
      "fullname",
      "municipality",
      "province"
    ];
    for (const field of required) {
      if (!cleanUser[field] || cleanUser[field] === "") {
        return res
          .status(400)
          .json({ error: `Falta el campo obligatorio: ${field}` });
      }
    }

    const allowedSpecs = [
      "Ninguno",
      "Psicología",
      "Psicopedagogía",
      "Logopedia",
      "Psicometría",
      "Pedagogía"
    ];
    if (!allowedSpecs.includes(cleanUser.userspec)) {
      return res
        .status(400)
        .json({ error: `Especialidad inválida: ${cleanUser.userspec}` });
    }

    // 🚨 TRIGGER BACKEND: Asignar alarmas VIGENTES al nuevo usuario
    console.log(
      `🔄 [TRIGGER] Asignando alarmas vigentes a ${cleanUser.userid}`
    );
    await conn.execute(
      `
      INSERT IGNORE INTO alarms_users (alarms_ida, userid, scheduledate, \`read\`)
      SELECT DISTINCT a.ida, ?, NOW(), 0
      FROM alarms a
      WHERE a.active = 1
        AND a.startdate <= NOW()
        AND (a.endingdate IS NULL OR a.endingdate >= NOW())
        AND (
          (a.scope_type = 'self' AND a.username = ?) OR
          (a.scope_type = 'municipio' AND a.scope_valor = ?) OR
          (a.scope_type = 'provincia' AND a.scope_valor = ?) OR
          (a.scope_type = 'global') OR
          (a.scope_type = 'rol' AND 
          EXISTS (
            SELECT 1 FROM auxusersrol aur 
            JOIN auxrols r ON aur.rol_id = r.idr 
            WHERE aur.userid = ? AND r.name = a.scope_valor
          ))
        )
    `,
      [
        cleanUser.userid,
        cleanUser.userid,
        cleanUser.municipality,
        cleanUser.province,
        cleanUser.userid
      ]
    );

    // Insertar usuario
    const sqlUsers = `
      INSERT INTO users
      (userid, userpass, useremail, userspec, active, registeredpend,
       fullname, municipality, province)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
    `;
    await conn.execute(sqlUsers, [
      cleanUser.userid,
      cleanUser.userpass,
      cleanUser.useremail,
      cleanUser.userspec,
      cleanUser.active,
      cleanUser.registeredpend,
      cleanUser.fullname,
      cleanUser.municipality,
      cleanUser.province
    ]);

    // Asignar roles (DESPUÉS del trigger porque usa auxusersrol)
    for (const rolName of cleanUser.roles) {
      const [rolResult] = await conn.execute(
        "SELECT idr FROM auxrols WHERE name = ?",
        [rolName.trim()]
      );
      if (rolResult.length > 0) {
        await conn.execute(
          "INSERT INTO auxusersrol (userid, rol_id) VALUES (?, ?)",
          [cleanUser.userid, rolResult[0].idr]
        );
      }
    }

    // Auditoría
    await auditAction({
      req,
      actor: req.user,
      action: AUDIT_ACTIONS.CREATE,
      entity: AUDIT_ENTITIES.USER,
      entityId: cleanUser.userid,
      description: `Creación de usuario con roles: [${cleanUser.roles.join(
        ", "
      )}]`,
      newState: { ...cleanUser, userpass: undefined }
    });

    await conn.commit();

    res.json({
      success: true,
      userid: cleanUser.userid,
      roles: cleanUser.roles,
      permisos: cleanUser.permissions,
      message: "Usuario creado + alarmas vigentes asignadas"
    });
  } catch (err) {
    await conn.rollback();
    console.error("❌ Error /api/newuser:", err);
    res.status(500).json({ error: err.message || "Error interno" });
  } finally {
    conn.release();
  }
};

