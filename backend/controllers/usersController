exports.approve = async (req, res) => {
  const { userid, rolId } = req.body;

  if (!userid || !rolId) {
    return res.status(400).json({
      error: "userid y rolId son requeridos"
    });
  }

  const conn = await pool.getConnection();

  try {
    await conn.beginTransaction();

    // 1️⃣ Activar usuario
    const [updateUser] = await conn.execute(
      `
      UPDATE users
      SET active = 1,
          registeredpend = 0
      WHERE userid = ?
    `,
      [userid]
    );

    if (updateUser.affectedRows === 0) {
      throw new Error("Usuario no encontrado");
    }

    // 2️⃣ Verificar si ya tiene rol
    const [existing] = await conn.execute(
      `
      SELECT *
      FROM auxusersrol
      WHERE userid = ?
    `,
      [userid]
    );

    if (existing.length > 0) {
      // 3️⃣ Actualizar rol existente
      await conn.execute(
        `
        UPDATE auxusersrol
        SET rol_id = ?
        WHERE userid = ?
      `,
        [rolId, userid]
      );
    } else {
      // 4️⃣ Insertar nuevo rol
      await conn.execute(
        `
        INSERT INTO auxusersrol (userid, rol_id)
        VALUES (?, ?)
      `,
        [userid, rolId]
      );
    }

    await conn.commit();

    return res.json({
      success: true,
      message: "Usuario aprobado correctamente"
    });
  } catch (err) {
    await conn.rollback();

    console.error("❌ Error en approve:", err);

    return res.status(500).json({
      error: err.message
    });
  } finally {
    conn.release();
  }
};

exports.recoverycode = async (req, res) => {
  const { username, codeForPass } = req.body;

  if (!username || typeof username !== "string" || username.length > 50) {
    return res.status(400).json({ error: "Username inválido" });
  }

  try {
    const [rows] = await runQuery(
      "SELECT useremail FROM users WHERE userid = ?",
      [username],
      req,
      { username }
    );

    if (rows.length === 0) {
      return res.status(404).json({ error: "Usuario no encontrado" });
    }

    const useremail = rows[0].useremail;

    // ✅ EMAIL SIMPLE Y SEGURO (sin regex vulnerable)
    const isValidEmail = (email) => {
      if (!email || typeof email !== "string" || email.length > 254)
        return false;
      if (email.includes("..") || email.includes("  ")) return false;
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    };

    if (!isValidEmail(useremail)) {
      console.error("Email inválido en BD:", useremail);
      return res.status(500).json({ error: "Error interno" });
    }

    const safeEmail = String(useremail).replace(/[\r\n\t]/g, "");
    const safeCode = String(codeForPass).replace(/[\r\n\t]/g, "");

    safeCode;
    console.log("safeCode: ", safeCode);
    await sendEmail(
      safeEmail,
      "Código para cambiar la contraseña",
      `Tu código es: ${safeCode}`
    );

    await auditAction({
      req,
      actor: { username },
      action: AUDIT_ACTIONS.PASSWORD_CHANGE,
      entity: AUDIT_ENTITIES.USER,
      entityId: username,
      description: `Se envió código de recuperación por correo`,
      metadata: { email: useremail }
    });

    res.status(200).json({ message: "Correo enviado" });
  } catch (error) {
    console.error("Error recuperación:", error.message);
    res.status(500).json({ error: "Error interno" });
  }
};

